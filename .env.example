APP_NAME="CFLAG DMR"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://YOUR_DEV_SERVER_IP

DB_HOST=localhost
DB_NAME=cflag_dmr_dev
DB_USER=cflag_dmr_user
DB_PASS=change_me
SESSION_SECURE_COOKIE=false

EMAIL_DEV_MODE=true

# SMTP — used when EMAIL_DEV_MODE=false
# port 465 = implicit TLS (SMTPS), port 587 = STARTTLS, port 25 = plain
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@cflag.net
MAIL_FROM_NAME="CFLAG DMR"
